{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/certificates.html",
      "destination": "/credentials",
      "statusCode": 301
    },
    {
      "source": "/en/certificates.html",
      "destination": "/en/credentials",
      "statusCode": 301
    },
    {
      "source": "/certificates",
      "destination": "/credentials",
      "statusCode": 301
    },
    {
      "source": "/en/certificates",
      "destination": "/en/credentials",
      "statusCode": 301
    },
    {
      "source": "/index.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/en/index.html",
      "destination": "/en",
      "statusCode": 301
    },
    {
      "source": "/:path*/index.html",
      "destination": "/:path*",
      "statusCode": 301
    },
    {
      "source": "/:path*.html",
      "destination": "/:path*",
      "statusCode": 301
    }
  ]
}
