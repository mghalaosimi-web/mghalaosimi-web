{
  "name": "@mghal/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --max-warnings=0",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run check:production",
    "check:production": "node --check worker.production.js && node --check ../public/assets/social-engagement.js && node --check ../public/assets/visitor-tracking.js"
  },
  "dependencies": {
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261031.1",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "eslint": "^9.39.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8",
    "wrangler": "^4.45.0"
  }
}
