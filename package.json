{
  "name": "mghal-digital-identity",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run audit:design && npm run audit:legacy-html && npm run audit:pwa && npm run test:navigation && npm run test:search && npm run test:security-headers && npm run test:structured-data && npm run test:seo && npm run test:sitemap && npm run test:project-pages && npm run test:admin && npm run test:engagement-hydration && npm run test:api-runtime && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "audit:credentials": "node scripts/audit-credentials.mjs",
    "test:certificates": "node scripts/test-certificate-sync.mjs",
    "audit:profile": "node scripts/audit-profile-content.mjs",
    "lint": "npm --prefix mghal-backend run lint",
    "test:api-runtime": "node --test mghal-backend/node/tests/vercel-runtime.node-test.mjs",
    "test:seo": "node --test scripts/test-seo-alternates.test.mjs",
    "test:sitemap": "node --test scripts/test-sitemap.test.mjs",
    "test:navigation": "node scripts/test-navigation.mjs",
    "audit:design": "node scripts/audit-design.mjs",
    "test:search": "node scripts/test-search-palette.mjs",
    "test:security-headers": "node scripts/test-security-headers.mjs",
    "test:structured-data": "node scripts/test-structured-data.mjs",
    "test:project-pages": "node scripts/test-project-pages.mjs",
    "audit:pwa": "node scripts/audit-pwa.mjs",
    "test:engagement-hydration": "node scripts/test-engagement-hydration.mjs",
    "audit:legacy-html": "node scripts/audit-legacy-html.mjs",
    "test:admin": "node scripts/test-admin-panel.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "15.5.28",
    "pg": "^8.23.1",
    "react": "19.1.2",
    "react-dom": "19.1.2"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "postcss": "8.5.32",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "postcss": "8.5.32"
  }
}
